backend/storage/encrypted_papers/*
!backend/storage/encrypted_papers/.gitkeep
backend/storage/keys/*
!backend/storage/keys/.gitkeep

# Build artifacts
frontend/dist/
frontend/build/
.turbo/

# Logs
logs/
*.log
npm-debug.log*

# OS Files
.DS_Store
Thumbs.db
