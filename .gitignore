# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/
ai-service/venv/
ai-service/__pycache__/
*.pyc

# Environment & Secrets
.env
backend/.env
ai-service/.env

# Local Database & SQLite files
*.db
*.db-journal
backend/prisma/*.db
