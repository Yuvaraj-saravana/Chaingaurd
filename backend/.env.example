# CHAINGUARD Backend Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (SQLite default for seamless zero-config local run; switchable to PostgreSQL)
DATABASE_URL="file:./dev.db"

# JWT Secret Key
JWT_SECRET=chainguard_super_secret_jwt_key_2026_exam_security_platform
JWT_EXPIRES_IN=8h

# File Storage Configuration
ENCRYPTED_STORAGE_DIR=./storage/encrypted_papers
KEYS_STORAGE_DIR=./storage/keys
MAX_FILE_SIZE_MB=25

# AI Service URL
AI_SERVICE_URL=http://localhost:5001

# Blockchain Driver Mode: "SANDBOX" or "FABRIC"
# SANDBOX generates real SHA-256 block hashes, Merkle roots, and cryptographic audit proofs in-memory.
# FABRIC connects directly to running Hyperledger Fabric peer nodes.
BLOCKCHAIN_MODE=SANDBOX
FABRIC_CHANNEL=examchannel
FABRIC_CHAINCODE=chainguard-cc
